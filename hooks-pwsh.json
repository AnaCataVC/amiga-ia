{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|run_command",
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"./hooks/scripts/ami-hooks.ps1\" -Event PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "shell": "pwsh",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"./hooks/scripts/ami-hooks.ps1\" -Event PostToolUse"
          }
        ]
      }
    ]
  }
}
