{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|run_command",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ./hooks/scripts/ami-hooks.sh -e PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash ./hooks/scripts/ami-hooks.sh -e PostToolUse"
          }
        ]
      }
    ]
  }
}
